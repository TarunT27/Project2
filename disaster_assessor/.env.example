# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real keys.

# Claude vision damage detection. Either paste an API key from https://console.anthropic.com here,
# or leave it blank and sign in once with the Anthropic CLI:  brew install anthropics/tap/ant && ant auth login
ANTHROPIC_API_KEY=

# Skip sign-in for a single-user local demo (localhost only).
DRA_NO_LOGIN=1

# Optional tuning
# DRA_DETECT_MODEL=claude-opus-5-5
# DRA_DETECT_EFFORT=medium
